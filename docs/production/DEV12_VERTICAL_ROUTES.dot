digraph VerticalWorld {
graph [bgcolor="#f8f9fc", pad=0.34, ranksep="0.65", nodesep="0.29", fontname="Noto Serif CJK SC", label="Lost Frequency  dev12 — 关卡内部立体路线（源码设计图，未经实机验收）", labelloc=t, fontsize=21, fontcolor="#263040", overlap=false, compound=true];
node [shape=box, style="rounded,filled", fontname="Noto Serif CJK SC", fontsize=10, margin="0.16,0.10", penwidth=1.1];
edge [color="#52677d", arrowsize=0.65, penwidth=1.5, fontname="Noto Serif CJK SC", fontsize=8];
subgraph cluster_L003 {
label="L003｜电力站"; style="rounded,filled"; fillcolor="#ffffff"; color="#087e8b"; penwidth=2; fontsize=14; margin=24;
"L003_floor" [label="floor\n0.00 m", fillcolor="#d9ebf5", color="#087e8b"];
"L003_control" [label="control\n3.60 m", fillcolor="#e8effa", color="#087e8b"];
