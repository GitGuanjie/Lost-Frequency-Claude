; LOST FREQUENCY — canon-locked Backrooms adaptation (Godot 4.5)
; Engine config. Input actions are registered at runtime by autoload/Settings.gd
; so they can be rebound and saved.

config_version=5

[application]

config/name="LOST FREQUENCY"
config/version="1.3.0-m4"
config/description="A source-locked adaptation of the English Backrooms Wikidot continuity. 100-level roster, honest per-level acceptance status."
run/main_scene="res://ui/MainMenu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="LostFrequency"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://autoload/Settings.gd"
LevelRegistry="*res://autoload/LevelRegistry.gd"
SessionState="*res://autoload/SessionState.gd"
SaveService="*res://autoload/SaveService.gd"
AudioSynth="*res://autoload/AudioSynth.gd"
MatLib="*res://autoload/MatLib.gd"
TransitionService="*res://autoload/TransitionService.gd"
Telemetry="*res://autoload/Telemetry.gd"
Overlay="*res://ui/Overlay.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
textures/default_filters/anisotropic_filtering_level=2
